generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url = "file:./dav.db"
}

model ShortUrl {
  id         Int       @id @default(autoincrement())
  code       String    @unique   // 6位短码
  longUrl    String    // 原始长链接
  clicks     Int       @default(0)   // 点击次数统计
  createdAt  DateTime  @default(now())
}